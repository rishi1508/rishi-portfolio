---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Rishi Mishra, Forward Deployed Engineer',
  description = 'Rishi Mishra builds AI agents and internal tools at WonderLend Hubs, and works with the teams using them until they actually help.',
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const siteUrl = 'https://rishi1508.github.io/rishi-portfolio/';
const nav = [
  { href: `${base}#work`, label: 'Work' },
  { href: `${base}#approach`, label: 'Approach' },
  { href: `${base}#recognition`, label: 'Recognition' },
  { href: `${base}#contact`, label: 'Contact' },
];
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Rishi Mishra" />
    <link rel="canonical" href={siteUrl} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:image" content={`${siteUrl}og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Rishi Mishra, Forward Deployed Engineer" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}og-image.png`} />

    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}manifest.json`} />
    <meta name="theme-color" content="#E8EEF6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0F1A33" media="(prefers-color-scheme: dark)" />

    <link rel="preload" href={`${base}fonts/bricolage-display.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${base}fonts/literata-text.woff2`} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={`
      @font-face {
        font-family: 'Bricolage Grotesque';
        src: url('${base}fonts/bricolage-display.woff2') format('woff2-variations');
        font-weight: 500 700; font-stretch: 75% 100%; font-style: normal; font-display: swap;
      }
      @font-face {
        font-family: 'Literata';
        src: url('${base}fonts/literata-text.woff2') format('woff2-variations');
        font-weight: 400 600; font-style: normal; font-display: swap;
      }
    `} />

    <!-- Theme before first paint, and a js flag so no-JS visitors see everything. -->
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        var t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
    </script>

    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: 'Rishi Mishra',
      jobTitle: 'Forward Deployed Engineer, Agentic Initiatives',
      worksFor: { '@type': 'Organization', name: 'WonderLend Hubs' },
      address: { '@type': 'PostalAddress', addressLocality: 'Jaipur', addressCountry: 'IN' },
      alumniOf: { '@type': 'CollegeOrUniversity', name: 'MBM Engineering College, Jodhpur' },
      url: siteUrl,
      email: 'mailto:rishimishra1508@gmail.com',
      sameAs: ['https://github.com/rishi1508', 'https://www.linkedin.com/in/rishimishra1508'],
    })} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header" data-header>
      <div class="container site-header__inner">
        <a class="brand" href={`${base}#top`}>Rishi Mishra</a>
        <div class="site-header__actions">
          <button class="menu-button" type="button" aria-expanded="false" aria-controls="site-nav" data-menu>
            <span>Menu</span>
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 18 18"><path d="M3 5.5h12M3 9h12M3 12.5h12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" fill="none"/></svg>
          </button>
          <nav class="site-nav" id="site-nav" aria-label="Primary" data-menu-panel>
            <ul>
              {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
            </ul>
          </nav>
          <button class="theme-toggle" type="button" aria-pressed="false" aria-label="Dark theme" title="Toggle dark theme" data-theme-toggle>
            <svg class="icon-moon" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
            <svg class="icon-sun" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6"/></g></svg>
          </button>
        </div>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container site-footer__inner">
        <p>&copy; {year} Rishi Mishra</p>
        <slot name="footer" />
      </div>
    </footer>

    <script is:inline>
      (function () {
        var root = document.documentElement;
        var mq = matchMedia('(prefers-color-scheme: dark)');
        var btn = document.querySelector('[data-theme-toggle]');
        function isDark() {
          var t = root.getAttribute('data-theme');
          return t ? t === 'dark' : mq.matches;
        }
        function sync() { btn.setAttribute('aria-pressed', String(isDark())); }
        btn.addEventListener('click', function () {
          var next = isDark() ? 'light' : 'dark';
          root.setAttribute('data-theme', next);
          try { localStorage.setItem('theme', next); } catch (e) {}
          sync();
        });
        mq.addEventListener('change', sync);
        sync();

        // Small screens: a plain disclosure menu.
        var menu = document.querySelector('[data-menu]');
        var panel = document.querySelector('[data-menu-panel]');
        function close() { menu.setAttribute('aria-expanded', 'false'); panel.classList.remove('is-open'); }
        menu.addEventListener('click', function () {
          var open = menu.getAttribute('aria-expanded') !== 'true';
          menu.setAttribute('aria-expanded', String(open));
          panel.classList.toggle('is-open', open);
        });
        panel.addEventListener('click', function (e) { if (e.target.closest('a')) close(); });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && menu.getAttribute('aria-expanded') === 'true') { close(); menu.focus(); }
        });
        document.addEventListener('click', function (e) {
          if (menu.getAttribute('aria-expanded') === 'true' && !e.target.closest('[data-header]')) close();
        });

        // A hairline under the header once the page has scrolled.
        var header = document.querySelector('[data-header]');
        function onScroll() { header.classList.toggle('is-scrolled', scrollY > 8); }
        addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      })();
    </script>
  </body>
</html>
