---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Layout title="Page not found, Rishi Mishra" description="This page does not exist.">
  <section class="section notfound">
    <div class="container">
      <p class="meta">Error 404</p>
      <h1 class="h1">Page not found</h1>
      <p class="lede">There is nothing at this address. It may have moved when the site was rebuilt.</p>
      <p class="actions"><a class="button button--primary" href={base}>Go to the home page</a></p>
    </div>
  </section>
</Layout>
