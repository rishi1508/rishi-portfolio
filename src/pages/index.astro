---
import { execSync } from 'node:child_process';
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

// The footer names the commit this page was built from. In CI that is
// GITHUB_SHA; locally it falls back to git.
let sha = process.env.GITHUB_SHA ?? '';
if (!sha) {
  try { sha = execSync('git rev-parse HEAD').toString().trim(); } catch { sha = ''; }
}
const shortSha = sha.slice(0, 7);

type Entry = {
  period: string;
  name: string;
  started?: string;
  built?: string;
  changed?: string;
  now?: string;
  aside?: string;
  link?: boolean;
};

// Oldest first. Every figure here is from the verified list in the brief.
const work: Entry[] = [
  {
    period: 'Aug to Sep 2025',
    name: 'Changelog validator',
    started: 'Malformed deployment changelogs kept breaking deploys.',
    built: 'Type and query validation, with error previews, inside the changelog tool developers already used.',
    changed: 'Malformed changelogs went from 10 to 15 a month to under 1.',
  },
  {
    period: 'Nov 2025',
    name: 'Java Lambda automation',
    started: 'Our deployment automation only understood Python.',
    built: 'Extended it to Java Lambdas, with a Maven CI pipeline and a way to import existing functions into Terraform state. Tenant lists now load live instead of being hardcoded.',
    changed: 'Java services deploy through the same path as everything else.',
  },
  {
    period: 'Jan to Apr 2026',
    name: 'TenantHub',
    started: 'Setting up a new tenant took about a week of one person’s time.',
    built: 'One-click tenant setup, a validator and a decommissioner, provisioning across 17 AWS service modules. Live in staging from January and in production from April 2026.',
    changed: 'About 1 week down to 15 to 20 minutes.',
    aside: 'Along the way I found the validator was silently swallowing AWS auth failures and reporting “0 issues” on broken tenants, so I added extraction-error tracking across all 12 extractors and comparators.',
  },
  {
    period: 'May 2026',
    name: 'Claude seat bot',
    started: 'Leads were allocating shared Claude seats by hand.',
    built: 'A Slack bot with scheduling, queuing and priority-based assignment.',
    changed: 'Around 1,500 bookings a month, with no manual allocation.',
  },
  {
    period: 'May to Jun 2026',
    name: 'DevOps Bot',
    started: 'Every alarm paged a human, who ran the same checks before they could act.',
    built: 'An always-on AI assistant in Slack with read-only access to infrastructure, narrowly scoped Jira write, role-based access and an audit trail. In production in May, company-wide in June 2026.',
    changed: '1,401 alarms diagnosed and 69 colleagues served. Triage starts with the evidence already gathered.',
    link: true,
  },
  {
    period: 'Sep 2026',
    name: 'AuditHub',
    started: 'Client security questionnaires were answered by hand, from scratch, every time.',
    built: 'An AI-assisted portal behind SSO, with role-based access, AI drafting, review and a knowledge base.',
    changed: 'Answers start from a reviewed draft instead of a blank page.',
  },
  {
    period: 'Sep to Oct 2026',
    name: 'A shared agent framework',
    started: 'Teams were starting to build agents separately, each re-solving security, memory, cost and audit.',
    built: 'Helped set the company’s direction for how agents get built, then built the foundation of a shared framework where an agent is a configuration file, not code.',
    changed: '28 modules and 325 tests, with no third-party dependencies in its core. Also the company’s first measured cost baseline for running agents.',
  },
  {
    period: 'Nov 2026 onward',
    name: 'Forward Deployed Engineer',
    now: 'I moved into the Founder’s Office to take agents to the teams that need them, and to bring back evidence of what works.',
  },
];

// Verified figures only, oldest first.
const highlights = [
  { value: '15 to 20 min', label: 'to set up a new tenant, down from about a week', source: 'TenantHub' },
  { value: '~1,500', label: 'Claude seat bookings a month, with no manual allocation', source: 'Claude seat bot' },
  { value: '1,401', label: 'alarms diagnosed for 69 colleagues, with read-only access', source: 'DevOps Bot' },
];

const codeHtml = (lines: string[][]) =>
  lines.map(([k, line]) => (k ? `<span class="diff-${k}">${line}</span>` : line)).join('\n');

const steps = [
  {
    who: 'Alarm', kind: 'alarm', text: 'Error rate above threshold on a payments function, staging.',
    caption: 'The alarm goes to the agent first, not to a person’s phone.',
  },
  {
    who: 'Agent', kind: 'agent', text: 'Reading recent logs for the payments function.',
    code: [['', 'ERROR  card-service call timed out'], ['', 'ERROR  card-service call timed out'], ['', 'WARN   retry budget exhausted']],
    label: 'Log excerpt',
    caption: 'It can read logs, metrics and config. It cannot change any of them.',
  },
  {
    who: 'Agent', kind: 'agent', text: 'The last deployment changed one setting.',
    code: [['del', '- card_service.timeout_profile: standard'], ['add', '+ card_service.timeout_profile: aggressive']],
    label: 'Configuration change',
    caption: 'It looks where a person would look first.',
  },
  {
    who: 'Agent', kind: 'summary',
    text: 'Likely cause: the timeout profile changed in the last deployment, and card-service calls started timing out right after it went out.',
    note: 'Evidence attached: log excerpt, configuration change, error rate. Suggested next step: revert the setting. Needs a person.',
    caption: 'The summary arrives with the evidence attached, so triage starts from the answer.',
  },
  {
    who: 'On-call engineer', kind: 'human', text: 'Agreed. Reverting it now.',
    caption: 'A person makes the fix. That is by design.',
  },
];
---

<Layout>
  <!-- Hero -->
  <section class="hero" id="top">
    <div class="container hero__grid">
      <div class="hero__copy">
        <h1 class="hero__name">Rishi Mishra</h1>
        <p class="hero__role">Forward Deployed Engineer, Agentic Initiatives at WonderLend Hubs</p>
        <p class="hero__lede">I build AI agents and internal tools, then stay with the teams using them until they actually help.</p>
        <p class="actions">
          <a class="button button--primary" href="#work">See the work</a>
          <a class="button button--secondary" href="mailto:rishimishra1508@gmail.com">Email me</a>
        </p>
      </div>
      <figure class="hero__photo">
        <img
          src={`${base}rishi-portrait-400.webp`}
          srcset={`${base}rishi-portrait-400.webp 400w, ${base}rishi-portrait-800.webp 800w`}
          sizes="(min-width: 900px) 360px, (min-width: 600px) 280px, 200px"
          width="400" height="500"
          alt="Rishi Mishra in a white t-shirt, leaning on a wooden railing outdoors."
          fetchpriority="high" decoding="async"
        />
      </figure>
    </div>

    <div class="container">
      <h2 class="visually-hidden">Highlights</h2>
      <ul class="highlights">
        {highlights.map((h) => (
          <li>
            <p class="highlights__value">{h.value}</p>
            <p class="highlights__label">{h.label}</p>
            <p class="highlights__source">{h.source}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- How it usually starts -->
  <section class="section section--band" id="start" aria-labelledby="start-title">
    <div class="container split">
      <h2 class="h2" id="start-title">How it usually starts</h2>
      <div class="split__body">
        <p class="large">Almost none of this started out looking like innovation. It started as small irritations: a deployment step that kept going wrong, an alert that always needed the same three checks, a manual process everyone had simply accepted.</p>
        <p>Each one looked too small to be a project. The hard part was never the technology. It was understanding the problem properly, sitting with the people who had it, and building something they would actually use.</p>
      </div>
    </div>
  </section>

  <!-- The work, oldest first -->
  <section class="section" id="work" aria-labelledby="work-title">
    <div class="container">
      <header class="section__head">
        <h2 class="h2" id="work-title">The work, in order</h2>
        <p class="section__intro">Everything since I joined WonderLend Hubs in June 2025, oldest first. Associate DevOps Engineer until October 2026, Forward Deployed Engineer since November.</p>
      </header>

      <ol class="timeline" data-timeline>
        {work.map((e, i) => (
          <li class:list={['entry', { 'entry--now': i === work.length - 1 }]} data-entry>
            <p class="entry__date">{e.period}</p>
            <span class="entry__dot" aria-hidden="true"></span>
            <div class="entry__body">
              <h3 class="entry__name">{e.name}</h3>
              {e.now ? (
                <p class="entry__now">{e.now}</p>
              ) : (
                <dl class="entry__facts">
                  <div><dt>Started from</dt><dd>{e.started}</dd></div>
                  <div><dt>Built</dt><dd>{e.built}</dd></div>
                  <div class="entry__changed">
                    <dt>Changed</dt>
                    <dd>
                      {e.changed}
                      {e.link && <> <a href="#alarm">See how it handles an alarm</a></>}
                    </dd>
                  </div>
                </dl>
              )}
              {e.aside && (
                <p class="entry__aside"><strong>Engineering note.</strong> {e.aside}</p>
              )}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- The signature: what a read-only agent does with an alarm -->
  <section class="section section--band alarm" id="alarm" aria-labelledby="alarm-title" data-alarm>
    <div class="alarm__track" data-alarm-track>
      <div class="alarm__sticky">
        <div class="container alarm__grid">
          <div class="alarm__intro">
            <h2 class="h2" id="alarm-title">What a <span class="nowrap">read-only</span> agent does with an alarm</h2>
            <p class="alarm__note">An illustrative example, not a real incident. Every name and value in it is invented.</p>

            <div class="alarm__captions" aria-hidden="true">
              <p class="alarm__counter"><span data-alarm-count>1</span> of {steps.length}</p>
              <div class="alarm__bars">
                {steps.map(() => <span></span>)}
              </div>
              {steps.map((s, i) => <p class="alarm__caption" data-caption={i}>{s.caption}</p>)}
            </div>
          </div>

          <div class="thread" role="group" aria-label="Example message thread">
            <p class="thread__head">
              <span>Agent: read access</span>
              <span>People: can act</span>
            </p>
            <ol class="thread__list">
              {steps.map((s, i) => (
                <li class:list={['step', `step--${s.kind}`]} data-step={i}>
                  <div class="msg">
                    <p class="msg__who">{s.who}</p>
                    <p class="msg__text">{s.text}{s.kind === 'human' && <span class="caret" aria-hidden="true"></span>}</p>
                    {s.code && (
                      <pre class="msg__code" aria-label={s.label}><code set:html={codeHtml(s.code)} /></pre>
                    )}
                    {s.note && <p class="msg__note">{s.note}</p>}
                  </div>
                  <p class="step__caption">{s.caption}</p>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How I build -->
  <section class="section" id="approach" aria-labelledby="approach-title">
    <div class="container">
      <header class="section__head">
        <h2 class="h2" id="approach-title">How I build</h2>
      </header>
      <ul class="principles">
        <li>
          <h3 class="h3">Built to be adopted, not tolerated.</h3>
          <p>If people route around a tool, it has failed, however clever it is.</p>
        </li>
        <li>
          <h3 class="h3">Guardrails in the system, not in the prompt.</h3>
          <p>Permissions, scopes and audit trails do the safety work. A model can be talked out of a rule in a prompt; it cannot talk its way past a permission it does not have.</p>
        </li>
        <li>
          <h3 class="h3">Numbers I can defend.</h3>
          <p>Every figure on this page is measured. Where something was not measured, there is no number.</p>
        </li>
      </ul>

      <div class="skills">
        <h3 class="h3">What I work with</h3>
        <dl class="skills__list">
          <div>
            <dt>Day to day</dt>
            <dd>AWS (Lambda, ECS, EC2, RDS, API Gateway, Cognito, DynamoDB, SQS, SNS, Route 53, IAM, CloudWatch), Terraform, Python, GitLab CI, Docker, Linux.</dd>
          </div>
          <div>
            <dt>Agents</dt>
            <dd>Claude API, tool use and permissioned agents, Slack integrations, evaluation and cost measurement.</dd>
          </div>
          <div>
            <dt>Education</dt>
            <dd>BE in Electronics and Computer Science, MBM Engineering College, Jodhpur.</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- Recognition, oldest first, and one earlier project -->
  <section class="section section--band" id="recognition" aria-labelledby="recognition-title">
    <div class="container">
      <header class="section__head">
        <h2 class="h2" id="recognition-title">Recognition</h2>
      </header>
      <ol class="list">
        <li>
          <p class="list__date">Apr 2026</p>
          <div>
            <h3 class="h3">Winner, internal hackathon, WonderLend Hubs</h3>
            <p>An AI invoice portal, since integrated into the company’s workflow.</p>
          </div>
        </li>
        <li>
          <p class="list__date">Jul 2026</p>
          <div>
            <h3 class="h3">3rd place, Google Build with AI: Code for Communities</h3>
            <p>Run by Google Developer Groups, among 7,000+ teams. Smart Health, built with Rupesh Sharma, Isha Desai and Devik Bansal (team ai-rangers). We presented it to Members of Parliament at Demo Day in New Delhi on 22 July 2026.</p>
            <p><a href="https://certificate.hack2skill.com/verify/2026CFC-W00041" rel="noopener">Verify certificate</a></p>
          </div>
        </li>
        <li>
          <p class="list__date">Sep 2026</p>
          <div>
            <h3 class="h3">AI Bodh session</h3>
            <p>Presented to 125+ colleagues on working with AI.</p>
          </div>
        </li>
      </ol>

      <h2 class="h2 h2--small" id="earlier-title">An earlier project</h2>
      <div class="project">
        <h3 class="h3">Land registry on Ethereum</h3>
        <p>A decentralised land registry: register parcels, verify ownership and transfer property through smart contracts, with the full ownership history on chain.</p>
        <p class="project__stack">Solidity, Truffle, React, Web3.js, MetaMask</p>
        <p><a href="https://github.com/rishi1508/land-registry-blockchain" rel="noopener">Source on GitHub</a></p>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section class="section contact" id="contact" aria-labelledby="contact-title">
    <div class="container">
      <h2 class="h2" id="contact-title">Contact</h2>
      <p class="large contact__line">Email is the best way to reach me.</p>
      <p class="actions">
        <a class="button button--primary" href="mailto:rishimishra1508@gmail.com">rishimishra1508@gmail.com</a>
      </p>
      <ul class="contact__links">
        <li><a href="https://www.linkedin.com/in/rishimishra1508" rel="noopener">LinkedIn</a></li>
        <li><a href="https://github.com/rishi1508" rel="noopener">GitHub</a></li>
        <li>Jaipur, India</li>
      </ul>
    </div>
  </section>

  {shortSha && (
    <p slot="footer">Built with Astro, deployed by GitHub Actions from commit <a href={`https://github.com/rishi1508/rishi-portfolio/commit/${sha}`} rel="noopener"><code>{shortSha}</code></a></p>
  )}

  <script>
    import '../scripts/page.js';
  </script>
</Layout>
